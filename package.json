{
  "name": "kozikowski-it",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run test && npm run typecheck && npm run build",
    "test": "node --test \"src/**/*.test.mts\" \"scripts/**/*.test.mjs\"",
    "metrics:audit": "npm exec --yes --package=lighthouse@13.6.0 -- lighthouse http://127.0.0.1:3100 --preset=desktop --output=json --chrome-flags=--headless",
    "metrics:measure": "node scripts/measure-site.mjs"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "^10",
    "prettier": "3.9.10",
    "sass": "1.107.1",
    "typescript": "~5.9.3"
  },
  "type": "module"
}
